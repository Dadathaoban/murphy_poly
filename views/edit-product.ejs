<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Product | Murphy Poly</title>
    <style>
        body { font-family: sans-serif; background: #f4f7f9; padding: 40px; }
        .container { max-width: 600px; margin: auto; background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        h1 { color: #002b5c; }
        label { font-weight: bold; display: block; margin-top: 15px; color: #333; }
        input, textarea { width: 100%; padding: 12px; margin: 5px 0 10px 0; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; }
        .save-btn { background: #004a99; color: white; border: none; padding: 15px; width: 100%; font-weight: bold; cursor: pointer; border-radius: 4px; font-size: 1rem; }
        .cancel { display: block; text-align: center; margin-top: 15px; color: #666; text-decoration: none; }
    </style>
</head>
<body>
    <div class="container">
        <h1>Edit Product</h1>
        <form action="/admin/edit/<%= product.id %>" method="POST">
            <label>Product Name</label>
            <input type="text" name="name" value="<%= product.name %>" required>
            
            <label>Category</label>
            <input type="text" name="category" value="<%= product.category %>" required>
            
            <label>Price (₦)</label>
            <input type="number" step="0.01" name="price" value="<%= product.price %>" required>
            
            <label>Image URL</label>
            <input type="text" name="image_url" value="<%= product.image_url %>">
            
            <label>Specifications</label>
            <textarea name="specs" rows="5"><%= product.specs %></textarea>
            
            <button type="submit" class="save-btn">Save Changes</button>
        </form>
        <a href="/admin" class="cancel">Cancel and Go Back</a>
    </div>
</body>
</html>
